# frozen_string_literal: true

# Shared dependency set, eval'd by BOTH Gemfile (prod / released) and Gemfile.dev
# (bleeding-edge test-kit commits). The gems that intentionally DIFFER between
# environments are declared in the including Gemfile, NOT here: au_core_test_kit,
# au_ps_inferno, and (for the duration of the inferno_core 1.4.x upgrade) inferno_core
# itself. Everything in this file is identical across envs and flows to prod normally.

source "https://rubygems.org"

ruby '3.3.6'

gem 'pg'

# Test-kit support gems. Currently the same commit in every environment, so they live
# here. Pinned to explicit refs for reproducibility (validation_test_kit previously
# floated to the beda-software default branch, including in prod).
gem 'validation_test_kit', git: 'https://github.com/beda-software/validation-test-kit', ref: '3438159ae5860216d37c559725fbfdc316ad745c'

# inferno_suite_generator is a runtime dependency of the generated AU Core suites (they
# require 'inferno_suite_generator/utils/helpers' and subclass its test classes). Its ref
# must match the version the pinned au_core_test_kit was built against.
#
# da378cb is the generator's main at the time au_core_test_kit 1.4.5 was cut, and 1.4.5's
# own Gemfile tracks this gem at branch: main, so this is the pairing the AU Core v3.0.0
# -ballot1 suite was generated and tested against. Pinned by SHA rather than by branch
# because main is a moving target and this repo builds reproducibly.
#
# Moving off the previous ref (9b0d17e) is also what unblocks inferno_core 1.4.x:
# ReferenceResolutionTest at 9b0d17e validated reference targets out of Validator
# internals that inferno_core removed in v1.1.0, and the generated AU Core v2.0.0,
# v2.1.0-draft and v3.0.0-ballot1 suites include that module across 68 tests. The old
# block was wrapped in `rescue StandardError`, so those tests would fail rather than
# error, reading as a conformance problem with the server under test.
gem 'inferno_suite_generator', github: 'hl7au/inferno_suite_generator', ref: 'da378cb0db730c83be414b66650f2ae29bcc8f83'

gem 'sinatra'
gem 'sidekiq-cron'

# Pin connection_pool to the 2.x line. Sidekiq 7.x calls TimedStack#pop with a
# positional timeout, but connection_pool 3.0 made that keyword-only, so 3.x raises
# "wrong number of arguments (given 1, expected 0)" and kills Sidekiq's scheduler/cron
# poller thread (e.g. the Old Session Deletion cron silently stops).
#
# The pin is redundant while inferno_core requires 'sidekiq ~> 7.3.10', because sidekiq
# 7.3.10 itself declares 'connection_pool >= 2.3.0, < 3'. It is kept as a belt-and-braces
# guard and because the failure mode is silent. connection_pool 3.0 was adopted in sidekiq
# 8.x, not 7.3 as an earlier version of this comment claimed, so drop this only once
# inferno_core moves to sidekiq 8.
gem 'connection_pool', '~> 2.5'

# OpenTelemetry. The worker and the web process both emit spans to Alloy, which forwards
# them to Tempo. Rack instrumentation is what gives the web process a server span per
# inbound HTTP request: without it, work that happens outside a test run (notably session
# creation, which serialises the whole suite tree) is untraceable, and outbound calls made
# while serving a request have no parent span to attach to.
gem 'opentelemetry-sdk'
gem 'opentelemetry-exporter-otlp'
gem 'opentelemetry-instrumentation-faraday'
gem 'opentelemetry-instrumentation-net_http'
gem 'opentelemetry-instrumentation-rack'
gem 'opentelemetry-instrumentation-sidekiq'

group :development, :test do
  gem 'jekyll'
  gem 'database_cleaner-sequel', '~> 1.8'
  gem 'factory_bot', '~> 6.1'
  gem 'rspec', '~> 3.10'
  gem 'webmock', '~> 3.11'
end
