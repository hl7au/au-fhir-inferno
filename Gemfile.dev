# frozen_string_literal: true

# DEVELOPMENT dependency set: tracks bleeding-edge, unreleased test-kit commits for the
# dev environment (development.inferno.sparked-fhir.com) and local development. It has
# its OWN lockfile, Gemfile.dev.lock. Select it with:
#
#   BUNDLE_GEMFILE=Gemfile.dev bundle install
#
# Do NOT move unreleased SHAs into the base Gemfile: keeping them quarantined here is
# what stops a development -> master merge from dragging unreleased test-kit versions
# into prod. Swap a floor below for a `github:`/`ref:` pin when dev should track an
# unreleased commit, and move it back once that commit ships.

eval_gemfile 'Gemfile.common'

# Bleeding-edge AU Core test kit. Floored at the release carrying the inferno_core 1.4.x
# reference-resolution fix; Gemfile.dev.lock pins the exact version.
gem 'au_core_test_kit', '>= 1.4.6'


# Bleeding-edge AU PS test kit — unreleased commit ahead of the RubyGems release.
gem 'au_ps_inferno', github: 'hl7au/au-ps-inferno', ref: '5a21bc85e534334b1e1c18e0c7be1a5f65b90d60'
